# 复制为 .env 后填写；.env 已被 Git 忽略。私有仓库使用只读 Token。
GITHUB_USERNAME=your-account
GITHUB_REPO=your-repository
GITHUB_PAT=

# 使用 Gitee 时填写下面两项；仓库名称仍使用 GITHUB_REPO。
GITEE_USERNAME=
GITEE_TOKEN=

BRANCH=main
RUN_COMMAND=python3 main.py
UPDATE_INTERVAL=60
APP_PORT=4567
PROXY_HOST=

# 建议填写实际健康接口，例如 http://127.0.0.1:4567/health。
# 留空时只检查新进程在观察期内没有退出，不能保证业务可用。
HEALTHCHECK_URL=
STARTUP_GRACE_SECONDS=10
HEALTHCHECK_TIMEOUT=60
STOP_TIMEOUT=20

# 应用自己的配置（例如数据库连接信息）也可填写在这里。
